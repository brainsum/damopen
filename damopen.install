<?php

/**
 * @file
 * Install, update and uninstall functions for the damo install profile.
 *
 * @todo: https://www.drupal.org/docs/8/distributions/creating-distributions/how-to-write-a-drupal-8-installation-profile#s-install-file
 */

/**
 * Install the damopen_common module.
 */
function damopen_update_8001() {
  Drupal::service('module_installer')->install(['damopen_common']);
}

/**
 * Switch to the imagemagick toolkit.
 */
function damopen_update_8002() {
  Drupal::service('module_installer')->install(['imagemagick']);

  $configFactory = Drupal::configFactory();
  $config = $configFactory->getEditable('system.image');
  $config->set('toolkit', 'imagemagick');
  $config->save(TRUE);
  $config = $configFactory->getEditable('imagemagick.settings');
  $config->set('quality', 80);
  $config->save(TRUE);
}

/**
 * Remove deprecated modules.
 */
function damopen_update_8003() {
  /** @var \Drupal\Core\Extension\ModuleInstallerInterface $installer */
  $installer = Drupal::service('module_installer');
  $installer->uninstall([
    'better_formats',
    'jquery_ui_datepicker',
  ]);
}


/**
 * Remove deprecated modules.
 */
function damopen_update_8004() {
  $configFactory = Drupal::configFactory();
  $config = $configFactory->getEditable('system.mail');
  $interface = $config->get('interface');
  $interface['default'] = 'php_mail';
  $config->set('interface', $interface);
  $config->save(TRUE);

  /** @var \Drupal\Core\Extension\ModuleInstallerInterface $installer */
  $installer = Drupal::service('module_installer');
  $installer->uninstall([
    'maillog',
    'exception_mailer',
  ]);
}

/**
 * Remove deprecated modules.
 */
function damopen_update_8005() {
  /** @var \Drupal\Core\Extension\ModuleInstallerInterface $installer */
  $installer = Drupal::service('module_installer');
  $installer->uninstall([
    'r4032login',
  ]);
}

/**
 * Implements hook_install().
 */
function damopen_install() {
  _damopen_configure_gin();
}

/**
 * Brands Gin, the admin theme, and its login page for DAMopen.
 */
function _damopen_configure_gin(): void {
  $profile = \Drupal::service('extension.list.profile')->getPath('damopen');
  $damo_theme = \Drupal::service('extension.list.theme')->getPath('damo_theme');
  $config = \Drupal::configFactory();
  // A darker DAMopen teal keeps white button text readable.
  $config->getEditable('gin.settings')
    ->set('preset_accent_color', 'custom')
    ->set('accent_color', '#1f808b')
    ->set('classic_toolbar', 'horizontal')
    // Asset library pages keep their own header.
    ->set('secondary_toolbar_frontend', FALSE)
    ->save();
  $config->getEditable('gin_login.settings')
    ->set('logo', ['use_default' => FALSE, 'path' => "$profile/images/logo-dark.png"])
    ->set('brand_image', ['use_default' => FALSE, 'path' => "$damo_theme/images/dam--header-image.jpg"])
    ->save();
}

/**
 * Use Gin for the admin pages, media forms and login page.
 */
function damopen_update_11001() {
  \Drupal::service('theme_installer')->install(['gin']);
  \Drupal::service('module_installer')->install(['gin_toolbar', 'gin_login']);
  \Drupal::configFactory()->getEditable('system.theme')->set('admin', 'gin')->save();
  // Admin paths used Claro; the approval pages keep damo_theme.
  $config = \Drupal::configFactory()->getEditable('switch_page_theme.settings');
  $rules = $config->get('spt_table') ?? [];
  foreach ($rules as &$rule) {
    if (($rule['theme'] ?? '') === 'claro') {
      $rule['theme'] = 'gin';
    }
  }
  $config->set('spt_table', $rules)->save();
  _damopen_configure_gin();
  // Show the few categories as checkboxes instead of a multi-select list.
  $storage = \Drupal::entityTypeManager()->getStorage('entity_form_display');
  foreach ($storage->loadByProperties(['targetEntityType' => 'media']) as $display) {
    $component = $display->getComponent('field_category');
    if (($component['type'] ?? '') === 'options_select') {
      $display->setComponent('field_category', ['type' => 'options_buttons'] + $component)->save();
    }
  }
}
