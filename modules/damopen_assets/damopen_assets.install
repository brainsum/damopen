<?php

/**
 * @file
 * Update and install routines for damopen_assets.
 */

/**
 * Implements hook_update_N().
 */
function damopen_assets_update_8001() {
  /** @var \Drupal\Core\Extension\ModuleHandlerInterface $moduleHandler */
  $moduleHandler = Drupal::service('module_handler');
  if (!$moduleHandler->moduleExists('select2')) {
    /** @var \Drupal\Core\Extension\ModuleInstallerInterface $moduleInstaller */
    $moduleInstaller = Drupal::service('module_installer');
    $moduleInstaller->install(['select2']);
  }
}

/**
 * Add the fields that record why a reviewer rejected an asset.
 */
function damopen_assets_update_11001() {
  $updateManager = \Drupal::entityDefinitionUpdateManager();
  foreach (_damopen_assets_rejection_field_definitions() as $name => $definition) {
    if (!$updateManager->getFieldStorageDefinition($name, 'media')) {
      $updateManager->installFieldStorageDefinition($name, 'media', 'damopen_assets', $definition);
    }
  }
}
