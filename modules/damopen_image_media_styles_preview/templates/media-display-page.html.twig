<div class="media-page-wrapper">
  <div class="images-wrapper left-wrapper">
    {% for row in rows.images %}
      <div class="image {{ row.metadata.data.identifier }} {% if loop.index == 2 %}active{% endif %}" identifier="{{ row.metadata.data.identifier }}">{{ row.image.data }}</div>
    {% endfor %}
  </div>
  <div class="right-wrapper">
    <div class="top-controls">
      <h4 class="media-title">{{ title }}</h4>
      <input type="checkbox" id="watermark" name="watermark" value="on"> <label for="watermark">Add the Company logo to the image</label>
      {% for key, links in rows.controllers %}
        <div class="controller {{ key }}">
          {% for index, link in links %}
            {% if link.identifier %}
              <div class="link {% if loop.parent.loop.first and index == 1 %}active{% endif %}" identifier="{{ link.identifier }}">
                {{ link.download_link }}
              </div>
            {% endif %}

            {% if link.media_collection.add_to_collection_link %}
              {% if link.identifier %}
                <div class="link {% if loop.parent.loop.first and index == 1 %}active{% endif %}" identifier="{{ link.identifier }}">
                  {{ link.media_collection.add_to_collection_link }}
                  <div class="collection-list">
                    {% for collection in link.media_collection.add_to_collection_list %}
                      <div class="collection-link-wrapper">
                        <a class="use-ajax add-to-collection-link {% if collection.in_collection %} in-collection {% endif %}" title="{{ 'Add to'|t }} {{ collection.title }}" href="/collections/{{ collection.id }}/add/{{ collection.mid }}/other_hi_res_no_badge">{{ collection.title }}</a>
                        {% if collection.in_collection %}
                          <a class="use-ajax remove-from-collection-link" title="{{ 'Remove'|t }}" href="/collections/remove/{{ collection.uuid }}/{{ collection.itemuuid }}"></a>
                        {% endif %}
                      </div>
                    {% endfor %}
                    <span class="collection-divider"></span>
                    <div class="collection-link-wrapper create-collection">
                      <a href="/collections/add?destination=/media/{{ link.media_collection.mid }}&source={{ link.media_collection.mid }}" class="use-ajax add-to-collection-link" data-dialog-type="modal">Create a new collection</a>
                    </div>
                  </div>
                </div>
              {% endif %}
            {% endif %}
          {% endfor %}
        </div>
      {% endfor %}
    </div>

    <div class="image-controls">
      {% for key, links in rows.controllers %}
        <div class="controller {{ key }} {{ links.classes }}">
          <div class="title-wrapper {{ links.classes }}">
            <span class="icon">
               <i class="{{ links.icon_class }}"></i>
            </span>
            <h4> {{ key }} </h4>
          </div>
          {% for link in links %}
            {% if link.badge %}
              <div class="link {% if loop.parent.loop.first %}active{% endif %}" identifier="{{ link.identifier }}">
                {{ metadata.media_collection.added_to_collection_icon }}
                {{ link.label }}
                {{ metadata.media_collection.remove_from_collection_text }}
              </div>
            {% endif %}
          {% endfor %}
        </div>
      {% endfor %}
    </div>
  </div>
</div>

